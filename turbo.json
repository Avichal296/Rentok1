
{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PORT",
    "ADMIN_API_KEY",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "WEB_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "ADMIN_API_KEY",
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "WEB_ORIGIN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

